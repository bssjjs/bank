# 换行：仓库里统一 LF，检出时也统一 LF（Windows 上不让 git 改成 CRLF，
# 否则同一个文件在两台机器上的 sha256 会不一样，指纹对不上）。
* text=auto eol=lf

# 文本文件再显式声明一次，方便 review 时看清
*.py       text eol=lf
*.toml     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.gitignore      text eol=lf
*.gitattributes  text eol=lf

# 二进制：不做换行转换，也不能当文本 diff
*.parquet  binary
*.db       binary
*.joblib   binary
*.zip      binary
*.png      binary
*.jpg      binary